<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================= -->
  <!--  C# mirror of the deliberately-slow regression baseline.       -->
  <!--  Same anti-patterns as the JS baseline-suite/ - optimise me!   -->
  <!-- ============================================================= -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Pick up the deliberately-bad .runsettings automatically on `dotnet test`. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.55.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Microsoft Playwright Workspaces (Azure App Testing) — cloud browsers.
         Only active when PLAYWRIGHT_SERVICE_URL is set; otherwise `dotnet test`
         runs locally exactly as before. See PlaywrightServiceSetup.cs. -->
    <PackageReference Include="Azure.Developer.Playwright.NUnit" Version="1.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
