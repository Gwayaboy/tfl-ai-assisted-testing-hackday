# Microsoft Playwright Workspaces — the organiser gives you BOTH values below.
# Endpoint (from the workspace "Get started" page). Example:
#   PLAYWRIGHT_SERVICE_URL=wss://<region>.api.playwright.microsoft.com/playwrightworkspaces/<id>/browsers
PLAYWRIGHT_SERVICE_URL=

# Workspace access token (this suite uses access-token auth — no Azure sign-in
# needed). Treat it like a password: never commit it (.env is git-ignored).
PLAYWRIGHT_SERVICE_ACCESS_TOKEN=
