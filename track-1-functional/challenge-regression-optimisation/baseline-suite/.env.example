# Microsoft Playwright Workspaces — browser endpoint from the workspace
# "Get started" page (Azure portal). Example:
#   PLAYWRIGHT_SERVICE_URL=wss://<region>.api.playwright.microsoft.com/playwrightworkspaces/<id>/browsers
PLAYWRIGHT_SERVICE_URL=

# Only needed if the workspace uses ACCESS-TOKEN auth instead of Microsoft Entra
# ID (Entra is the default and recommended). Treat this like a password.
# PLAYWRIGHT_SERVICE_ACCESS_TOKEN=
