# Microsoft Playwright Workspaces — ONE shared config for BOTH regression suites
# (baseline-suite / JS and baseline-suite-dotnet / C#).
#
# Copy this file to `.env` in THIS folder (challenge-regression-optimisation/.env),
# which is git-ignored, and paste the two values the organiser gives you. Both
# suites read this single file:
#   • JS  — playwright.service.config.ts loads ../.env via dotenv
#   • C#  — DotEnv.cs walks up from the test bin and loads this .env
#
# 🧩 In a GitHub Codespace you do NOT need this file at all: PLAYWRIGHT_SERVICE_URL
# and PLAYWRIGHT_SERVICE_ACCESS_TOKEN are injected automatically as Codespaces
# secrets. Real environment variables always win over this file.

# Endpoint (workspace "Get started" ▸ Browser endpoint) — NOT a secret (safe to commit).
# Pre-filled for the pre-created TfL workspace (mpt-tfl-hackday, West Europe):
PLAYWRIGHT_SERVICE_URL=wss://westeurope.api.playwright.microsoft.com/playwrightworkspaces/e41e89d0-afe5-4e63-abe9-ba9078c7bd2d/browsers

# --- Auth: pick ONE -------------------------------------------------------------
# (A) Microsoft Entra ID (recommended): leave the token BLANK and `az login` to a
#     tenant with RBAC on the workspace — the suites use DefaultAzureCredential.
# (B) Access token: paste the workspace token below (access-token auth, no sign-in).
#     Treat it like a password: never commit it (.env is git-ignored).
PLAYWRIGHT_SERVICE_ACCESS_TOKEN=

# Optional overrides (sensible defaults are used when unset):
#   PLAYWRIGHT_SERVICE_OS=linux            # or "windows"
#   PLAYWRIGHT_SERVICE_EXPOSE_NETWORK=<loopback>
